# ============================================================
# .env.example · 模板文件（不含真实密钥）
# 复制为 .env 并填入真实值
# ============================================================

# 运行模式
NODE_ENV=development                  # development | production | test
PORT=3003                              # 后端端口

# 前端域名（用于生成邀请链接 / magic link）
# 开发：http://localhost:5175
# 生产：https://tarot-v3.layershop.store
FRONTEND_URL=http://localhost:5175

# 数据库
DATABASE_PATH=./data/tarot_v3.db

# Session
SESSION_COOKIE_NAME=arcana_session
SESSION_TTL_DAYS=30
SESSION_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS

# 管理员（Phase 5 Basic Auth）
# 用 node -e "console.log(require('bcryptjs').hashSync('YourPassword', 12))" 生成
ADMIN_USERNAME=mark
ADMIN_PASSWORD_HASH=$2a$12$PUT_YOUR_BCRYPT_HASH_HERE

# Magic Link / Email
# 生产环境用阿里云邮件推送
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code
SMTP_FROM="ARCANA 星语塔罗 <your_email@qq.com>"

# AI 模型（MiniMax M2.7）
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# 爱发电 Webhook
AFDIAN_USER_ID=your_afdian_user_id
AFDIAN_TOKEN=your_afdian_api_token

# 爱发电 7 个方案 ID（建好后填入）
AFDIAN_PLAN_LITE=plan_id_for_lite
AFDIAN_PLAN_CLASSIC=plan_id_for_classic
AFDIAN_PLAN_DEEP=plan_id_for_deep
AFDIAN_PLAN_SILVER_M=plan_id_for_silver_month
AFDIAN_PLAN_SILVER_Y=plan_id_for_silver_year
AFDIAN_PLAN_GOLD_M=plan_id_for_gold_month
AFDIAN_PLAN_GOLD_Y=plan_id_for_gold_year

# 灰度发布（Phase 6）
# 0 = 完全关闭 / 100 = 全量
CANARY_PERCENTAGE=100
# 白名单用户 ID（逗号分隔，始终进入新代码）
CANARY_USER_IDS=

# AI 成本监控告警阈值
AI_COST_DAILY_LIMIT=50                # ¥50/天
AI_USER_DAILY_LIMIT=100                # 单用户 100 次/天

# 防刷
ANTISPAM_ONE_DEVICE_ONE_INVITE=true
ANTISPAM_IP_24H_MAX_REGISTRATIONS=3