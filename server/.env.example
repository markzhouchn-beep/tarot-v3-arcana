# ============================================================
# server/.env.example · ARCANA v3.0 生产环境模板
# 创建：2026-09-02 · Mark 上线清单 Phase 0.3
#
# 部署步骤：
#   1. cp server/.env.example server/.env
#   2. 填入真实值（不要 commit .env）
#   3. MOCK_MODE=0（生产环境必须为 0）
# ============================================================

# ========== 服务 ==========
NODE_ENV=production
PORT=3003
DOMAIN=https://tarot-v3.layershop.store
FRONTEND_URL=https://tarot-v3.layershop.store

# 数据库
DB_PATH=/var/www/tarot-v3/server/data/tarot_v3.db

# Session（**64 位随机字符串**：openssl rand -hex 32）
SESSION_SECRET=***
SESSION_COOKIE_NAME=arcana_session
SESSION_TTL_DAYS=30

# ========== AI ==========
MINIMAX_API_KEY=***
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# ========== Mock 模式（生产必须 0） ==========
MOCK_MODE=0

# ========== 爱发电 ==========
AFDIAN_USER_ID=***
AFDIAN_TOKEN=***

# 单次解读 SKU（lite/classic/deep）
AFDIAN_SKU_SINGLE=***
AFDIAN_SKU_THREE=***
AFDIAN_SKU_TEN=***

# 会员订阅 plan_id
AFDIAN_PLAN_SILVER_MONTHLY=***
AFDIAN_PLAN_SILVER_YEARLY=***
AFDIAN_PLAN_GOLD_MONTHLY=***
AFDIAN_PLAN_GOLD_YEARLY=***

# webhook 简易验签密钥（爱发电后台 → 订单备注）
WEBHOOK_SECRET=***

# ========== 定价（与爱发电一致） ==========
PRICE_SINGLE=1.9
PRICE_THREE=3.9
PRICE_TEN=9.9
PRICE_SILVER_MONTHLY=19.9
PRICE_SILVER_YEARLY=199
PRICE_GOLD_MONTHLY=39.9
PRICE_GOLD_YEARLY=399

# ========== SMTP ==========
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=***
SMTP_PASS=***
SMTP_FROM=星语塔罗 <noreply@layershop.store>

# ========== 后台 ==========
ADMIN_USERNAME=mark
# 生成命令：node -e "console.log(require('bcryptjs').hashSync('YourPassword', 12))"
ADMIN_PASSWORD_HASH=***

# ========== 定时任务 ==========
RECONCILE_INTERVAL=60

# ========== 日志 ==========
LOG_LEVEL=info

# ========== 灰度发布 ==========
# 0 = 全量 / 100 = 全量；上线时先 5 → 20 → 100
CANARY_PERCENTAGE=100

# AI 成本监控告警（每日成本 / 单用户日限）
AI_COST_DAILY_LIMIT=50
AI_USER_DAILY_LIMIT=100