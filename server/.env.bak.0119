# ---- SMTP（阿里云邮件推送）----
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="星语塔罗 <noreply@tarot-v3.layershop.store>"

# ---- Session ----
SESSION_SECRET=change-me-to-32-byte-random-string-xxxxxxxxxxxx
SESSION_COOKIE_NAME=arcana_session
SESSION_TTL_DAYS=30

# ---- AI Mock 模式（开发用）----
# 设置为 1 时不调真 AI，用占位文本（节约 token）
MOCK_MODE=0

# ---- 管理后台（Mark）----
ADMIN_USERNAME=mark
ADMIN_PASSWORD_HASH=  # bcrypt hash，用 scripts/generate_admin_hash.js 生成

# ---- 定时 reconcile 间隔（秒）----
RECONCILE_INTERVAL=60

# ---- 日志 ----
LOG_LEVEL=info
